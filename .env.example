# Honeypot Dashboard configuration.
#
# Copy to `.env` and edit. Every value here is also a plain environment
# variable, so you can set them however your deployment prefers. Defaults are
# chosen so the stack runs locally with zero changes.

# ============================================================================
# Database
# ============================================================================
# Default: SQLite file in data/honeypot.db (WAL-tuned, no setup needed).
# For production, point at PostgreSQL:
#   DATABASE_URL=postgresql://honeypot:secret@localhost:5432/honeypot
# DATABASE_URL=

# ============================================================================
# Sensor identity & persona
# ============================================================================
SENSOR_NAME=default
HONEYPOT_BIND=0.0.0.0
HONEYPOT_HOSTNAME=srv-web-04

# One coherent fake identity across all services. Options:
#   ubuntu-generic | centos-legacy | iot-router | windows-iis
HONEYPOT_PERSONA=ubuntu-generic

# Fraction of logins to "accept" so we can observe post-auth behaviour.
# 0.0 = pure credential collection (never grant a shell).
ACCEPT_LOGIN_RATE=0.15

# ============================================================================
# Services (high ports by default so the process never needs root)
# ============================================================================
SSH_ENABLED=true
SSH_PORT=2222
TELNET_ENABLED=true
TELNET_PORT=2323
FTP_ENABLED=true
FTP_PORT=2121
HTTP_ENABLED=true
HTTP_PORT=8081

# ============================================================================
# Connection limits (protect the sensor, not the attacker)
# ============================================================================
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20
SESSION_TIMEOUT=120
READ_TIMEOUT=30
MAX_LINE_BYTES=8192
MAX_SESSION_BYTES=524288
MAX_EVENTS_PER_SESSION=500

# Source IPs never recorded (your own scanners, uptime checks). Comma-separated.
# IGNORE_IPS=203.0.113.7,198.51.100.0

# ============================================================================
# Capture
# ============================================================================
CAPTURE_PAYLOADS=true
# PAYLOAD_DIR=data/payloads
# Hash captured passwords instead of storing cleartext (regulated deployments):
HASH_PASSWORDS=false

# ============================================================================
# Storage / logging
# ============================================================================
WRITE_TO_DB=true
# JSONL_PATH=data/events.jsonl
ENRICH_INLINE=true
LOG_LEVEL=INFO

# ============================================================================
# API
# ============================================================================
# Blank captured passwords in API responses (they are often real, reused creds):
API_REDACT_PASSWORDS=false
# Dashboard origin(s), comma-separated. NEVER use * on an exposed host — see README.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required to start with a wildcard CORS origin. Leave unset in normal use.
# API_ALLOW_INSECURE=0
