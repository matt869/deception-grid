# Honeypot Dashboard configuration.
#
# Copy to `.env` and edit. Every value here is also a plain environment
# variable, so you can set them however your deployment prefers. Defaults are
# chosen so the stack runs locally with zero changes.

# ============================================================================
# Database
# ============================================================================
# Default: SQLite file in data/honeypot.db (WAL-tuned, no setup needed).
# For production, point at PostgreSQL:
#   DATABASE_URL=postgresql://honeypot:secret@localhost:5432/honeypot
# DATABASE_URL=

# ============================================================================
# Sensor identity & persona
# ============================================================================
SENSOR_NAME=default
HONEYPOT_BIND=0.0.0.0
HONEYPOT_HOSTNAME=srv-web-04

# One coherent fake identity across all services. Options:
#   ubuntu-generic | centos-legacy | iot-router | windows-iis
HONEYPOT_PERSONA=ubuntu-generic

# Fraction of logins to "accept" so we can observe post-auth behaviour.
# 0.0 = pure credential collection (never grant a shell).
ACCEPT_LOGIN_RATE=0.15

# ============================================================================
# Services (high ports by default so the process never needs root)
# ============================================================================
SSH_ENABLED=true
SSH_PORT=2222
TELNET_ENABLED=true
TELNET_PORT=2323
FTP_ENABLED=true
FTP_PORT=2121
HTTP_ENABLED=true
HTTP_PORT=8081
# Redis and MySQL bait bind their real ports directly — unprivileged, so no
# remap needed. Both are heavily scanned; leaving them on is free signal.
REDIS_ENABLED=true
REDIS_PORT=6379
MYSQL_ENABLED=true
MYSQL_PORT=3306

# ============================================================================
# Connection limits (protect the sensor, not the attacker)
# ============================================================================
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20
SESSION_TIMEOUT=120
READ_TIMEOUT=30
MAX_LINE_BYTES=8192
MAX_SESSION_BYTES=524288
MAX_EVENTS_PER_SESSION=500

# Source IPs never recorded (your own scanners, uptime checks). Comma-separated.
# IGNORE_IPS=203.0.113.7,198.51.100.0

# ============================================================================
# Capture
# ============================================================================
CAPTURE_PAYLOADS=true
# PAYLOAD_DIR=data/payloads
# Hash captured passwords instead of storing cleartext (regulated deployments):
HASH_PASSWORDS=false

# ============================================================================
# Storage / logging
# ============================================================================
WRITE_TO_DB=true
# JSONL_PATH=data/events.jsonl
ENRICH_INLINE=true
LOG_LEVEL=INFO

# ============================================================================
# API
# ============================================================================
# Blank captured passwords in API responses (they are often real, reused creds):
API_REDACT_PASSWORDS=false
# Dashboard origin(s), comma-separated. NEVER use * on an exposed host — see README.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required to start with a wildcard CORS origin. Leave unset in normal use.
# API_ALLOW_INSECURE=0

# ============================================================================
# Real-time alerting
# ============================================================================
# When detection raises a NEW alert at/above ALERT_MIN_SEVERITY, a message is
# POSTed to this webhook. Works with Slack, Discord, Microsoft Teams, or any
# generic JSON endpoint (kind is auto-detected from the URL). Unset = disabled.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_WEBHOOK_KIND=slack        # slack | discord | teams | generic (auto if unset)
ALERT_MIN_SEVERITY=high           # info|low|medium|high|critical
ALERT_MAX_PER_RUN=8               # cap messages per detection run (rest summarised)

# ============================================================================
# Daily digest
# ============================================================================
# A once-a-day summary POSTed to a webhook: volume, top sources, credentials,
# alerts, and any second-stage URLs (always defanged before posting). Discord
# gets a rich embed; Slack/Teams get markdown; anything else gets JSON.
# Falls back to ALERT_WEBHOOK_URL when unset, so one webhook can serve both.
# DIGEST_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# DIGEST_WEBHOOK_KIND=discord     # discord | slack | teams | generic (auto if unset)
DIGEST_HOURS=24                   # reporting window
DIGEST_TOP_N=5                    # rows per section
# Shown in the digest footer, so a reader can jump to the dashboard:
# DASHBOARD_URL=http://localhost:8080
